{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "apgo-monitor-dispatcher",
  "main": "index.mjs",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "vars": {
    "CENTRAL_REPOSITORY": "anpuuuuu/apgo-storefront-monitoring"
  },
  "kv_namespaces": [
    {
      "binding": "DELIVERIES",
      "id": "00000000000000000000000000000000"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
