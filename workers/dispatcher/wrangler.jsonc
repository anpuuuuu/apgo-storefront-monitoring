{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "apgo-monitor-dispatcher",
  "main": "index.mjs",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "vars": {
    "CENTRAL_REPOSITORY": "anpuuuuu/apgo-storefront-monitoring",
    "MONITOR_WORKER_URL": "https://apgo-error-monitor.wadeyeh.workers.dev",
    // Rollout gate for the Cron scheduler: false -> ticks are logged as skipped.
    "SCHEDULER_ENABLED": "true",
    // true -> plan and log every decision, never POST a workflow_dispatch.
    "SCHEDULER_DRY_RUN": "false"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Worker-to-Worker call for /health; a plain fetch to the other workers.dev
  // hostname is refused by Cloudflare (error 1042).
  "services": [
    {
      "binding": "MONITOR",
      "service": "apgo-error-monitor"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "DELIVERIES",
      "id": "640c1b6bdbd442c18c28ba6c83a63566"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
